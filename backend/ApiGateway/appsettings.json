{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },

      "asset-route": {
        "ClusterId": "asset-cluster",
        "Match": {
          "Path": "/api/activos/{**catch-all}"
        }
      },

      "category-route": {
        "ClusterId": "asset-cluster",
        "Match": {
          "Path": "/api/categorias/{**catch-all}"
        }
      },

      "depreciation-route": {
        "ClusterId": "depreciation-cluster",
        "Match": {
          "Path": "/api/depreciacion/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-service": {
            "Address": "http://localhost:5028/"
          }
        }
      },

      "asset-cluster": {
        "Destinations": {
          "asset-service": {
            "Address": "http://localhost:5005/"
          }
        }
      },

      "depreciation-cluster": {
        "Destinations": {
          "depreciation-service": {
            "Address": "http://localhost:5045/"
          }
        }
      }
    }
  }
}